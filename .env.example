# Copy to .env to override docker-compose defaults, or export these before
# running either module's `./mvnw spring-boot:run` directly. Shared by both
# document-service and document-indexer unless noted otherwise.

DB_HOST=localhost
DB_PORT=5432
DB_NAME=docsearch
DB_USER=docsearch
DB_PASSWORD=docsearch

# document-service only - document-indexer never touches Redis.
REDIS_HOST=localhost
REDIS_PORT=6379

ES_URIS=http://localhost:9200
ES_INDEX=documents

KAFKA_BOOTSTRAP_SERVERS=localhost:9092
KAFKA_DOCUMENT_TOPIC=document-index-events

# document-service only.
RATE_LIMIT_RPM=120
SEARCH_RATE_LIMIT_RPM=300
SEARCH_CACHE_TTL=30
DOCUMENT_CACHE_TTL=120

# document-service only - JWT signing. The default secret is fine for local
# dev (63 bytes, clears HS256's 32-byte minimum) but must be a real,
# injected secret in any shared/deployed environment - see docs/SUBMISSION.md
# §2 Security for why this is still self-issued rather than externally
# federated.
JWT_SECRET=local-dev-only-secret-key-not-for-production-use-32bytes+
JWT_EXPIRATION_MINUTES=60

# Ports - document-service splits public API traffic from actuator;
# document-indexer has no public API, so it only needs one port.
SERVER_PORT=8080
MANAGEMENT_PORT=8081
# document-indexer's SERVER_PORT (defaults to 8082) - only relevant when
# running both modules outside Docker on the same machine, where they'd
# otherwise collide on the same default port.
